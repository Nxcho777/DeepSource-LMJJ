<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEGUIMIENTO"
                android:textColor="#00F0E0"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#F7FAFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="108dp"
            android:layout_height="42dp"
            android:contentDescription="Deep Source"
            android:scaleType="fitCenter"
            android:src="@drawable/deepsource_logo" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/widget_divider"
        android:text="" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="PROYECTOS ACTIVOS"
        android:textColor="#B7B9F5"
        android:textSize="12sp"
        android:letterSpacing="0.10"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_projects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_add_time"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="＋  AÑADIR TIEMPO"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:textStyle="bold"
        android:background="@drawable/widget_button" />
</LinearLayout>
