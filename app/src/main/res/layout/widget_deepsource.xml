<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="105dp"
            android:layout_height="30dp"
            android:src="@drawable/deepsource_logo"
            android:scaleType="fitStart"
            android:contentDescription="DeepSource" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•••"
            android:textSize="19sp"
            android:textColor="#B4D1DF" />

    </LinearLayout>

    <ListView
        android:id="@+id/widget_projects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="3dp"
        android:scrollbars="none"
        android:fadeScrollbars="true"
        android:overScrollMode="never"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:visibility="gone"
        android:text="Sin proyectos activos"
        android:textSize="13sp"
        android:textColor="#B6CADB" />

    <LinearLayout
        android:id="@+id/widget_timer_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="5dp">
        <TextView
            android:id="@+id/widget_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="‹  Proyectos"
            android:textSize="12sp"
            android:textColor="#A8B5CC"
            android:paddingBottom="5dp"/>
        <TextView
            android:id="@+id/widget_selected_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#F4FAFF"
            android:textSize="15sp"
            android:maxLines="1"/>
        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:format="%s"/>
        <TextView
            android:id="@+id/widget_timer_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="#A8B5CC"
            android:paddingBottom="5dp"/>
        <TextView
            android:id="@+id/widget_start"
            android:layout_width="match_parent"
            android:layout_height="39dp"
            android:gravity="center"
            android:text="▶  Iniciar"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_timer_start"/>
        <LinearLayout
            android:id="@+id/widget_timer_actions"
            android:layout_width="match_parent"
            android:layout_height="39dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ⅱ  Pausar"
                android:textStyle="bold"
                android:textColor="#071827"
                android:textSize="13sp"
                android:background="@drawable/widget_timer_pause"/>
            <TextView android:layout_width="7dp" android:layout_height="1dp"/>
            <TextView
                android:id="@+id/widget_finish"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="■  Terminar"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/widget_timer_finish"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
