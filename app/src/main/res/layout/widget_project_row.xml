<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_project_row"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_project_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:background="@drawable/widget_icon_background"
        android:contentDescription="Ícono del proyecto" />

    <TextView
        android:id="@+id/widget_project_name"
        android:layout_width="0dp"
        android:layout_weight="1.25"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:textColor="#F4FAFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_weight="1.4"
        android:layout_height="8dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_progress_track">

        <ProgressBar
            android:id="@+id/widget_progress_blue"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressTint="#3B82F6"
            android:progressBackgroundTint="@android:color/transparent" />

        <ProgressBar
            android:id="@+id/widget_progress_yellow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressTint="#FACC15"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_progress_red"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressTint="#EF4444"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_progress_teal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressTint="#30B2A6"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_progress_black"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressTint="#242424"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/widget_project_percent"
        android:layout_width="43dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#F4FAFF" />

    <ImageView
        android:id="@+id/widget_project_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_widget_register_timer"
        android:tint="#83D9E3"
        android:contentDescription="Abrir cronómetro automático del proyecto"
        android:clickable="true" />

</LinearLayout>
