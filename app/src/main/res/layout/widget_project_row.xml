<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_project_row"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_row"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/widget_project_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F7FAFF"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/widget_row_divider"
        android:text="" />
    <LinearLayout
        android:layout_width="105dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_project_status"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="9dp"
            android:contentDescription="Estado"
            android:src="@drawable/widget_status_dot" />

        <TextView
            android:id="@+id/widget_project_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B7B9F5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_project_hours"
        android:layout_width="112dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_hours_chip"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="9dp"
        android:singleLine="true"
        android:textColor="#00F0E0"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
