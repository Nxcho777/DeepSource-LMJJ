<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base para Compose -->
    <style name="Theme.DeepSource" parent="@android:style/Theme.Material.NoActionBar" />

    <!-- Tema de carga nativa de Android -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Fondo oscuro oficial para evitar cualquier destello -->
        <item name="windowSplashScreenBackground">#080D1C</item>

        <!-- Oculta el icono antiguo del sistema usando transparencia -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <!-- Tema principal al finalizar la carga inicial -->
        <item name="postSplashScreenTheme">@style/Theme.DeepSource</item>
    </style>
</resources>